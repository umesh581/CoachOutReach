# --- Supabase ---
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, used for the Resend webhook and the public
# unsubscribe endpoint which run with no logged-in user session. Never expose
# this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL of this deployment, used to build unsubscribe links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret used to sign one-click unsubscribe links. Generate with:
#   openssl rand -hex 32
UNSUBSCRIBE_SECRET=change-me

# --- Provider API keys (fallback defaults) ---
# These can also be set per-account from the Settings page, which takes
# precedence over the env vars below when present.
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# --- Resend webhook signing secret (Svix) ---
# From the Resend dashboard webhook configuration.
RESEND_WEBHOOK_SECRET=
